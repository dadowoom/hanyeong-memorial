# 한영교회 추모관 환경값 칸 목록 (값은 비워 둠 — 실제 값은 서버 .env 에만, git 에 올리지 말 것)
# 코드가 읽는 칸 전부(server/_core/env.ts · index.ts · openGraph.ts · storage.ts · client import.meta.env).
# 사무실 서버(시험)에서는 시험값만: JWT_SECRET 무작위, VITE_APP_ID=office-test, OAuth·카카오·Forge 는 비워 둠.

# --- 서버 실행 ---
NODE_ENV=production
PORT=3000
# MySQL 접속 주소 mysql://사용자:비밀번호@호스트:3306/DB이름
DATABASE_URL=
# 업로드 파일 폴더(비우면 운영 기본 /var/www/hanyeong-memorial/uploads)
UPLOAD_DIR=
# 공유 미리보기(OG) 에 쓰는 사이트 주소(비우면 shared/church 의 도메인)
PUBLIC_SITE_URL=

# --- 로그인·세션 ---
# 세션 쿠키 서명 비밀값(비우면 안 됨 — 운영·시험 모두 길고 무작위로)
JWT_SECRET=
# 로그인 세션에 들어가는 앱 식별자(비우면 로그인 유지 안 됨)
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# --- 외부 저장소·API(Forge) — 쓰지 않으면 비워 둠 ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- 화면(빌드할 때 들어감, vite) ---
VITE_KAKAO_JAVASCRIPT_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
